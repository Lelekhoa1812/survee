{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "kqa/1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "presentation": {
      "type": "string",
      "enum": [
        "all",
        "guided"
      ]
    },
    "sections": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multi",
              "select",
              "rank",
              "text",
              "longtext",
              "number",
              "scale",
              "date"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "help": {
            "type": "string",
            "maxLength": 1000
          },
          "section": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "minItems": 2,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "value",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "maxSelections": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "note": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "placeholder": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5000
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000
          },
          "custom": {
            "type": "boolean"
          },
          "when": {
            "type": "object",
            "properties": {
              "all": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "question": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                        },
                        "operator": {
                          "type": "string",
                          "enum": [
                            "equals",
                            "notEquals",
                            "contains",
                            "notContains"
                          ]
                        },
                        "value": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
                        }
                      },
                      "required": [
                        "question",
                        "operator",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "question": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                        },
                        "operator": {
                          "type": "string",
                          "enum": [
                            "answered",
                            "notAnswered"
                          ]
                        }
                      },
                      "required": [
                        "question",
                        "operator"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "any": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "question": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                        },
                        "operator": {
                          "type": "string",
                          "enum": [
                            "equals",
                            "notEquals",
                            "contains",
                            "notContains"
                          ]
                        },
                        "value": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
                        }
                      },
                      "required": [
                        "question",
                        "operator",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "question": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                        },
                        "operator": {
                          "type": "string",
                          "enum": [
                            "answered",
                            "notAnswered"
                          ]
                        }
                      },
                      "required": [
                        "question",
                        "operator"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "label"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "rank"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "options": {
                  "maxItems": 8
                }
              },
              "required": [
                "options"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "format",
    "title",
    "questions"
  ],
  "additionalProperties": false
}
