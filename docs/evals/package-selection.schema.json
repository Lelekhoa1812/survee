{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kqa.invalid/schemas/package-selection-benchmark-v4.json",
  "title": "survee package selection benchmark result",
  "type": "object",
  "required": ["benchmarkVersion", "model", "runDate", "promptVersion", "packageLibraryVersion", "cases"],
  "properties": {
    "benchmarkVersion": { "const": "kqa-package-selection/6" },
    "model": { "type": "string", "minLength": 1 },
    "runDate": { "type": "string", "format": "date" },
    "promptVersion": { "type": "string", "minLength": 1 },
    "packageLibraryVersion": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseId", "decision"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "decision": {
            "type": "object",
            "required": ["action", "packageId", "candidatePackageIds", "clarificationSlots", "gates"],
            "properties": {
              "action": { "enum": ["recommend", "clarify", "out_of_scope"] },
              "packageId": { "type": ["string", "null"] },
              "candidatePackageIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "clarificationSlots": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "gates": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            },
            "allOf": [
              {
                "if": { "properties": { "action": { "const": "recommend" } }, "required": ["action"] },
                "then": {
                  "properties": {
                    "packageId": { "type": "string", "minLength": 1 },
                    "candidatePackageIds": { "maxItems": 0 },
                    "clarificationSlots": { "maxItems": 0 }
                  }
                }
              },
              {
                "if": { "properties": { "action": { "const": "clarify" } }, "required": ["action"] },
                "then": {
                  "properties": {
                    "packageId": { "type": "null" },
                    "candidatePackageIds": { "minItems": 2 },
                    "clarificationSlots": { "minItems": 1 }
                  }
                }
              },
              {
                "if": { "properties": { "action": { "const": "out_of_scope" } }, "required": ["action"] },
                "then": {
                  "properties": {
                    "packageId": { "type": "null" },
                    "candidatePackageIds": { "maxItems": 0 },
                    "clarificationSlots": { "maxItems": 0 }
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
