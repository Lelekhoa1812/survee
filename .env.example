# MongoDB connection (Atlas). Required.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name. Defaults to "kqa". Use a different name locally, for example kqa_dev.
MONGODB_DB=kqa

# Host login for /admin. Required in production (the app refuses to start the login without them).
ADMIN_EMAIL=admin@axiob.local
ADMIN_PASSWORD=change-me
# Random string used to sign the admin session cookie. Required in production.
SESSION_SECRET=generate-with-openssl-rand-base64-32

# Public origin written into invite emails (https://your-host). Required to send. No password in this value.
# The People screen still copies the address the host is looking at. The email does not.
KQA_PUBLIC_URL=https://your-kqa-host.example

# Bearer token for POST /api/mcp. At least 32 random characters. Not the admin password and not the session secret.
# openssl rand -base64 32
KQA_MCP_TOKEN=
# Optional cross-origin browser MCP clients, comma-separated serialized origins only.
# Origin-less server-to-server clients do not need this. KQA_PUBLIC_URL is also trusted.
KQA_MCP_ALLOWED_ORIGINS=

# Keep true while Axion's reviewed legacy-record backfill is pending. After a successful
# owner-reviewed backfill and a zero-unscoped audit, set false to enforce strict tenant filters.
KQA_AXION_LEGACY_TENANT_FALLBACK=true

# SMTP send on port 587 with STARTTLS. The password is an app password, never committed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# IMAP bounce check on port 993. Same mailbox as SMTP. Used only when a host or agent asks to check delivery.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
