# MongoDB connection (Atlas). Required.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name. Defaults to "kqa". Use a different name locally, for example kqa_dev.
MONGODB_DB=kqa

# Host login for /admin. Required in production (the app refuses to start the login without them).
ADMIN_EMAIL=admin@axion.local
ADMIN_PASSWORD=change-me
# Random string used to sign the admin session cookie. Required in production.
SESSION_SECRET=generate-with-openssl-rand-base64-32
