{
  "name": "kqa",
  "version": "1.0.0",
  "private": true,
  "description": "KQA: host-run interviews. Upload a self-contained HTML questionnaire, email or copy each person a private link, and keep every answer in MongoDB.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:questionnaire-author": "node scripts/eval-questionnaire-author.mjs",
    "eval:authoring-trust-boundary": "tsx scripts/eval-authoring-trust-boundary.ts",
    "eval:package-selection": "node scripts/eval-package-selection.mjs",
    "eval:repeatable-record-selection": "node scripts/eval-repeatable-record-selection.mjs",
    "eval:package-draft": "tsx scripts/eval-package-draft.ts",
    "check": "tsx scripts/check.ts",
    "audit:tenant-migration": "tsx scripts/audit-tenant-migration.ts",
    "a11y:audit": "node scripts/a11y-audit.mjs",
    "docs": "tsx scripts/gen-docs.ts",
    "e2e": "node scripts/e2e.mjs",
    "e2e:offline": "node scripts/offline-e2e.mjs",
    "e2e:concurrency": "node scripts/concurrency-check.mjs",
    "e2e:security": "node scripts/security-check.mjs",
    "e2e:probe": "node scripts/probe-e2e.mjs",
    "shots": "node scripts/shots.mjs",
    "shots:states": "node scripts/shots-states.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@datadog/sketches-js": "^2.1.1",
    "exceljs": "^4.4.0",
    "imapflow": "^2.11.0",
    "marked": "^18.2.0",
    "mongodb": "^7.9.0",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "parse5": "^8.1.1",
    "postcss": "8.5.23",
    "protobufjs": "^7.6.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "puppeteer-core": "^25.17.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
